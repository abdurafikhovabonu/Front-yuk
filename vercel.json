{
  "buildCommand": "npm run generate",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nuxtjs",
  "routes": [
    {
      "src": "/_nuxt/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "dest": "/_nuxt/$1"
    },
    {
      "src": "/(.*)\\.(json|ico|js|css|png|jpg|svg|webp|woff2?)",
      "dest": "/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}